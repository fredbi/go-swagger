{{/* serverParameterTarget is where the parameters section writes what serverParameter renders. */}}
{{ define "serverParameterTarget" }}{{ if .UseTags }}{{ joinFilePath .Target (toPackagePath .ServerPackage) (toPackagePath .APIPackage) (toPackagePath .Package) }}{{ else }}{{ joinFilePath .Target (toPackagePath .ServerPackage) (toPackagePath .Package) }}{{ end }}{{ end }}

{{/* serverParameterFileName is the name of the file it writes. */}}
{{ define "serverParameterFileName" }}{{ (snakize (pascalize .Name)) }}_parameters.go{{ end }}
